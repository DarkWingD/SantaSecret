<%- include('../partials/head', { title: (mode === 'edit' ? 'Edit event' : 'New Secret Santa') }) %>
<%- include('../partials/appnav') %>
<h1><%= mode === 'edit' ? 'Edit event' : 'New Secret Santa' %></h1>
<% if (error) { %><div class="banner banner-error"><%= error %></div><% } %>
<div class="card">
  <form method="post" action="<%= mode === 'edit' ? '/organiser/events/' + event.id + '/edit' : '/organiser/events' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/event_fields', { values: values }) %>
    <button class="btn btn-primary btn-block" type="submit"><%= mode === 'edit' ? 'Save changes' : 'Create event' %></button>
  </form>
</div>
<% if (mode === 'edit') { %>
  <p><a href="/organiser/events/<%= event.id %>">← Back to event</a></p>
<% } else { %>
  <p><a href="/organiser">← Back to your events</a></p>
<% } %>
<%- include('../partials/foot') %>
