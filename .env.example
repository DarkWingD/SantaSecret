# ─────────────────────────────────────────────────────────────
#  Secret Santa — configuration. Copy to `.env` and fill in.
#  NEVER commit your real `.env` (it is git-ignored).
# ─────────────────────────────────────────────────────────────

PORT=3001
BASE_URL=https://secretsanta.example.com
APP_TZ=Australia/Brisbane
SECRET=change-me-to-a-long-random-string

# The email address with full admin rights (must match a Cloudflare Access identity).
ADMIN_EMAIL=admin@example.com

# Cloudflare Access (organiser/admin auth)
CF_ACCESS_TEAM_DOMAIN=https://yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-aud-tag
# Local dev ONLY — bypass Access and act as DEV_EMAIL. Never true in production.
DEV_BYPASS_AUTH=false
DEV_EMAIL=admin@example.com

# Cloudflare Turnstile (captcha on the request form) — optional
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend). Blank RESEND_API_KEY disables email (logs instead).
RESEND_API_KEY=
MAIL_FROM=Secret Santa <no-reply@secretsanta.example.com>

# Retention: delete an event this many days after its exchange date.
PURGE_DAYS=30

# Abuse/scale caps (tunable)
MAX_ACTIVE_EVENTS_PER_ORG=20
MAX_MEMBERS_PER_EVENT=100
MAX_EVENTS_PER_DAY=10
MAX_SIGNUPS_PER_DAY=20
GLOBAL_ACTIVE_EVENT_CAP=200
MAX_WISHLIST_ITEMS=30
MAX_EDITS_PER_HOUR=60
