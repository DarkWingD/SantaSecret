[Unit]
Description=Secret Santa (Node)
After=network.target

[Service]
Type=simple
User=secretsanta
WorkingDirectory=/opt/secretsanta/app
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
